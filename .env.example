# Everything here is optional. Fork tests and the deploy dry run fall back to public
# endpoints, so `forge test` and `make deploy-dry` work with no configuration at all.

# Private RPC, if you have one. Public archive endpoints are the default.
BASE_RPC_URL=
ARBITRUM_RPC_URL=
MAINNET_RPC_URL=

# Required only for `--broadcast`.
PRIVATE_KEY=
ETHERSCAN_API_KEY=

# Deployment parameters. GUARDIAN defaults to the sender; the seed series is skipped when the
# pool or collateral is absent on the target chain.
GUARDIAN=
SEED_POOL=
SEED_COLLATERAL=
